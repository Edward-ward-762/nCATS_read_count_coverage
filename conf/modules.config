process {  
    withName: 'SAMTOOLS_INDEX' {
        publishDir = [
            enabled: false
        ]
    }

    withName: 'SAMTOOLS_COVERAGE' {
        ext.args   = { "-A -r ${meta.referenceName}:${meta.startCutSite}-${meta.endCutSite}" }
        publishDir = [
            path: { "${params.outdir}/input_data_metrics" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXTRACT_COVERAGE' {
        publishDir = [
            path: { "${params.outdir}/input_data_metrics" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'readsCount' {
        publishDir = [
            path: { "${params.outdir}/input_data_metrics" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_VIEW' {
        ext.args   = { "-h -e 'rlen >= $meta.lengthFilter'" }
        ext.prefix = { "${meta.id}_filtered" }
        publishDir = [
            path: { "${params.outdir}/filtered_bam_metrics" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAM_INDEX_BAM_FILT' {
        publishDir = [
            path: { "${params.outdir}/filtered_bam_metrics" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAM_COV_BAM_FILT' {
        ext.args   = { "-A -r ${meta.referenceName}:${meta.startCutSite}-${meta.endCutSite}" }
        ext.prefix   = { "${input.baseName}_filt" }
        publishDir = [
            path: { "${params.outdir}/filtered_bam_metrics" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'bam_filt_count' {
        publishDir = [
            path: { "${params.outdir}/filtered_bam_metrics" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'extract_bam_filt_cov' {
        publishDir = [
            path: { "${params.outdir}/filtered_bam_metrics" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'APPEND_COVERAGE' {
        publishDir = [
            path: { "${params.outdir}/APPEND_COVERAGE" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'COLLECT_STATS' {
        publishDir = [
            path: { "${params.outdir}/COLLECT_STATS" },
            mode: "${params.publish_dir_mode}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DUMP_SOFTWARE_VERSIONS' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: "${params.publish_dir_mode}",
            pattern: '*_versions.yml'
        ]
    }
}